# Copy to .env and fill in. Never commit .env.

# --- LLM layer (reportback/llm). Provider: foundry | openai | ollama ---
LLM_PROVIDER=foundry
# Foundry / Azure OpenAI v1 endpoint. Ollama fallback: http://localhost:11434/v1
LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
LLM_API_KEY=
# Deployment names on Foundry (model names on OpenAI/Ollama)
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
# Must match the vector(N) columns in backend/migrations
EMBEDDING_DIM=1536

# --- Cost guard for the offline linker ---
LINK_MAX_COST_USD=5

# --- Crawler ---
# Optional public project URL appended to the User-Agent. No personal email.
HTTP_CONTACT_URL=
